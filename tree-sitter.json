{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "rhombus",
      "camelcase": "Rhombus",
      "title": "Rhombus",
      "scope": "source.rhombus",
      "file-types": ["rhm", "shrb"],
      "injection-regex": "^(rhombus|shrubbery)$",
      "class-name": "TreeSitterRhombus",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Rhombus grammar for tree-sitter, based on shrubbery notation",
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-rhombus"
    }
  },
  "bindings": {
    "c": false, "go": false, "node": false, "python": false, "rust": false, "swift": false, "zig": false
  }
}
